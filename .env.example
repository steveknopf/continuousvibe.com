# Copy to .env.local and fill in.

# Stripe secret key (Dashboard > Developers > API keys). Use sk_test_... while testing.
STRIPE_SECRET_KEY=sk_test_...
# Publishable key from the same page, for the card field on the checkout form.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Public URL of the site, used for Stripe redirects and product images. Leave unset locally.
# SITE_URL=https://www.continuousvibe.com

# Contact form email delivery via https://resend.com (optional; without it the form asks people to email you).
# RESEND_API_KEY=re_...
# CONTACT_TO_EMAIL=humantypeinc@gmail.com
# CONTACT_FROM_EMAIL=Continuous Vibe <hello@continuousvibe.com>
